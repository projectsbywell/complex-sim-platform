# ------------------------------------------------------------------
# complex-sim-platform backend — environment template
# Copy to `.env` (or export) before starting the service.
# ------------------------------------------------------------------

# --- auth ----------------------------------------------------------
# JWT signing key. GENERATE a strong one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated usernames that register with role=admin
ADMIN_USERS=admin

# --- storage ---------------------------------------------------------
# Leave empty to use durable JSON files under DATA_DIR (zero deps).
# The storage interface is ready for external databases; when set, the
# backend activates the Postgres/Timescale/Mongo adapter seam:
#   postgresql://user:pass@host:5432/sims
#   timescale://user:pass@host:5432/sims
#   mongodb://user:pass@host:27017/sims
DATABASE_URL=
DATA_DIR=./data

# --- rate limiting ----------------------------------------------------
RATE_LIMIT_PER_MINUTE=100
# Comma-separated paths exempt from rate limiting
RATE_LIMIT_EXEMPT=/health,/docs,/redoc,/openapi.json
WS_MESSAGE_LIMIT_PER_MINUTE=120

# --- cache --------------------------------------------------------
CACHE_TTL_SECONDS=60
CACHE_MAXSIZE=1024

# --- simulation engine ------------------------------------------------
# Path to the simulation-core package (relative to the backend dir)
SIM_CORE_PATH=../simulation-core
# Work budget per step call (steps * engine cells) — rejects DoS-weight steps
SIM_MAX_WORK=20000000

# --- misc -----------------------------------------------------------
LOG_LEVEL=INFO
# "*" allows any origin (no credentials); or list explicit origins
CORS_ORIGINS=*